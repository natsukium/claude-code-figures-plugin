{
  "name": "figures",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "ANTHROPIC_API_KEY=unused timeout 120 claude -p --plugin-dir . hi >/dev/null 2>&1; test -f .claude-plugin/types/tsconfig.json",
    "build": "pnpm types && vite build",
    "test": "pnpm types && vitest run",
    "typecheck": "pnpm types && tsc -p ."
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.288",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@noble/hashes": "2.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
